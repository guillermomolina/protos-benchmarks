{
  "schema_version": 1,
  "runtimes": {
    "protos": {
      "image": "protos-benchmarks/protos:perf001c",
      "maven_build_image": "maven:3.9.9-eclipse-temurin-21",
      "graalvm": {
        "distribution": "GraalVM Community for JDK 22",
        "jdk_version": "22.0.0",
        "graal_truffle_line": "24.0.0",
        "base": "ghcr.io/graalvm/jdk-community:22.0.0"
      },
      "runtime_args": [
        "-Xss64m"
      ]
    },
    "python": {
      "version": "3.14.7",
      "image": "protos-benchmarks/python:perf001c",
      "base": "python:3.14.7-slim-bookworm",
      "recursion_limit": 50000
    },
    "javascript": {
      "runtime": "Node.js",
      "version": "24.20.0",
      "image": "protos-benchmarks/node:perf001c",
      "base": "node:24.20.0-bookworm-slim",
      "runtime_args": [
        "--stack-size=32768"
      ]
    }
  }
}

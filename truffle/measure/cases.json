{
  "schema": 1,
  "surfaces": {
    "dynamic": {
      "language": "protos",
      "classpath": "protos",
      "main_class": "com.guillermomolina.protos.benchmarks.measure.protos.ProtosDynamicSurface",
      "sources": [
        "measure/surfaces/protos/ProtosSurfaceSupport.java",
        "measure/surfaces/dynamic/ProtosDynamicSurface.java"
      ],
      "timed_call": "session.invokeTopLevel(\"run\")"
    },
    "prepared": {
      "language": "protos",
      "classpath": "protos",
      "main_class": "com.guillermomolina.protos.benchmarks.measure.protos.ProtosPreparedSurface",
      "sources": [
        "measure/surfaces/protos/ProtosSurfaceSupport.java",
        "measure/surfaces/prepared/ProtosPreparedSurface.java"
      ],
      "timed_call": "prepared.invoke()"
    },
    "canonical": {
      "language": "protos",
      "classpath": "protos",
      "main_class": "com.guillermomolina.protos.benchmarks.measure.protos.ProtosCanonicalSurface",
      "sources": [
        "measure/surfaces/protos/ProtosSurfaceSupport.java",
        "measure/surfaces/canonical/ProtosCanonicalSurface.java"
      ],
      "timed_call": "prepared.executable().execute()"
    },
    "executable-value": {
      "language": "peer",
      "classpath": "peer",
      "main_class": "com.guillermomolina.protos.benchmarks.measure.peer.PeerExecutableSurface",
      "sources": [
        "measure/surfaces/peer/PeerExecutableSurface.java"
      ],
      "timed_call": "context.getBindings(language).getMember(\"truffleRun\").execute()"
    }
  },
  "engine_sources": [
    "measure/engine/com/guillermomolina/protos/benchmarks/measure/MeasurementEngine.java"
  ],
  "policy": {
